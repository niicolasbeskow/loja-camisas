datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Artist {
  id             Int       @id @default(autoincrement())
  nome           String
  slug           String    @unique
  categoria_arte String
  bio            String?
  imagem_perfil  String?
  products       Product[]
}

model Product {
  id         Int    @id @default(autoincrement())
  nome       String
  preco      Float
  tipo       String // Tag or Colecao
  imagem     String?
  artista    Artist @relation(fields: [artista_id], references: [id])
  artista_id Int
  orderItems OrderItem[] @relation("OrderItemProduct")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]   @relation("OrderUser")
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  type                 String
  provider             String
  providerAccountId    String
  refresh_token        String?
  access_token         String?
  expires_at           Int?
  token_type           String?
  scope                String?
  id_token             String?
  session_state        String?
  access_token_expires DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id                 String    @id @default(cuid())
  userId             String?
  status             String    @default("PENDING")
  total              Float
  externalReference  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User?     @relation("OrderUser", fields: [userId], references: [id])
  items              OrderItem[] @relation("OrderUser")

  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation("OrderUser", fields: [orderId], references: [id])
  orderId   String
  product   Product  @relation("OrderItemProduct", fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Float
}
